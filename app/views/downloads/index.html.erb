<% if current_user.admin %>
	<%= content_tag(:div, "", id: "static_admin_header") %>
<% else %>
	<%= content_tag(:div, "", id: "static_header") %>
<% end %>
<h5 class="mx-5 my-3">ダウンロードファイル一覧</h5>
<% if @files.blank? %>
	<p class="m-5">ダウンロード可能な運転日報はありません。</p>
<% else %>
	<section class="export_daily_log_index">
		<div class="bg-image h-100">
			<div class="mask d-flex align-items-center h-100" style="background-color: white">
				<div class="container">
					<div class="row justify-content-center">
						<div class="col-12">
							<div class="card">
								<div class="card-body">
									<div class="table-responsive">
										<table class="table table-hover mb-0">
											<thead>
												<tr>
													<th>ダウンロード可能なPDF一覧</th>
												</tr>
											</thead>
											<tbody>
												<% @files.each do |file| %>
													<% display_filename = File.basename(file) %>
													<% route_filename = File.basename(file, '.pdf') %>
													<tr>
														<td scope="row"><%= link_to display_filename, download_path(route_filename) %></td>
													</tr>
												<% end %>
											</tbody>
										</table>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
<% end %>
