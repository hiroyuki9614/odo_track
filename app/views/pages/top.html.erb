<% if user_signed_in? %>
  <%= content_tag(:div, "", id: "static_header") %><br>
<% end %>
<% flash.each do |message_type, message| %>
  <div class="text-danger text-center text-bold">
    <%= message %>
  </div>
<% end %>
<% unless user_signed_in? %>
  <% demo_admin_password = ENV['DEMO_ADMIN_PASSWORD'].presence %>
  <% demo_user_password = ENV['DEMO_USER_PASSWORD'].presence %>
  <section class="container my-4" aria-labelledby="demo-login-heading">
    <div class="card shadow-sm border-primary">
      <div class="card-body">
        <h2 id="demo-login-heading" class="h5 mb-3">採用ご担当者様向け デモログイン</h2>
        <p class="mb-3">管理者・一般ユーザーの画面をそれぞれお試しいただけます。</p>
        <% if demo_admin_password && demo_user_password %>
          <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
              <div class="border rounded p-3 h-100">
                <h3 class="h6 fw-bold">管理者デモ（閲覧専用）</h3>
                <dl class="mb-0">
                  <dt>ID（メールアドレス）</dt>
                  <dd><code class="user-select-all">portfolio-demo-admin@example.com</code></dd>
                  <dt>パスワード</dt>
                  <dd><code class="user-select-all"><%= demo_admin_password %></code></dd>
                </dl>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="border rounded p-3 h-100">
                <h3 class="h6 fw-bold">一般ユーザーデモ</h3>
                <dl class="mb-0">
                  <dt>ID（メールアドレス）</dt>
                  <dd><code class="user-select-all">portfolio-demo-user@example.com</code></dd>
                  <dt>パスワード</dt>
                  <dd><code class="user-select-all"><%= demo_user_password %></code></dd>
                </dl>
              </div>
            </div>
          </div>
          <p class="small text-muted">公開ポートフォリオ用の共有デモアカウントです。実際の個人情報や業務データは入力しないでください。</p>
          <%= link_to 'デモにログインする', new_user_session_path, class: 'btn btn-primary text-white' %>
        <% else %>
          <p class="text-muted mb-0">デモログイン情報は現在準備中です。</p>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<h5 class="mx-2 mt-4">このアプリについて</h5><br>
<p class="m-3">業務で使用する運転日報を記録・管理するアプリです。</p>
<p class="m-3">走行距離や運転した車両を記録し、日報として管理できます。</p><br>
<p class="m-2">制作の背景</p>
<p class="m-3">以前の職場では、運転日報を手書きで記入しており、管理の煩雑さや入力の手間が課題になっていました。</p>
<p class="m-3">そのような日常業務の非効率を少しでも改善できる仕組みを作りたいと考え、このアプリを制作しました。</p><br>
<p class="m-2">- 基本機能</p>
<p class="m-3">ユーザー: 日報の投稿/編集/論理削除/一覧、運転する車両の登録（お気に入り機能）</p>
<p class="m-3">管理者: 日報の投稿/編集/論理削除/一覧、車両・社員情報の閲覧/編集、日報のPDF出力（Prawn / Whenever）</p><br>
<p class="m-2">- 使用技術</p>
<p class="m-3">フロントエンド: HTML/CSS, Bootstrap, Vue.js, Vuetify</p>
<p class="m-3">バックエンド: Ruby 3.2.2, Ruby on Rails 7.1.3</p><br>
<p class="m-2">- インフラ</p>
<p class="m-3">Docker Compose, PostgreSQL, Redis, Nginx, VPS, Let's Encrypt</p><br>
<p class="m-2">- テスト</p>
<p class="m-3">RSpec（GitHub Actionsでプルリクエスト時に自動実行）</p><br>
<p class="m-2">- 開発環境</p>
<p class="m-3">VS Code</p><br>
<p class="m-2">- 工夫した点</p>
<p class="m-3">ユーザーが使いやすいように、可能な限り入力する箇所を少なくしました。</p><br>
<p class="m-2">- 今後の追加予定</p>
<p class="m-3">メンテナンスログなどの機能を追加し、より包括的なサービスに改良する予定です。</p><br>
