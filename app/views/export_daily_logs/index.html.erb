<% if current_user.admin %>
	<%= content_tag(:div, "", id: "static_admin_header") %>
<% else %>
	<%= content_tag(:div, "", id: "static_header") %>
<% end %>
<div class="my-5 export-title">
	<h5>運転日報の印刷ページ</h5>
	<div class="card my-3">
		<div class="card-body">
			<h6 class="card-title">月次PDFを作成</h6>
			<p class="text-muted">対象月の全ユーザー分を個別PDFで作成し、ZIPにまとめます。</p>
			<%= form_with url: export_pdf_path, method: :post do |form| %>
				<div class="d-flex flex-wrap align-items-end gap-2">
					<div>
						<%= form.label :month, '対象月', class: 'form-label' %>
						<%= form.month_field :month, value: Date.current.strftime('%Y-%m'), class: 'form-control' %>
					</div>
					<%= form.submit '全員分を作成する', class: 'btn btn-primary' %>
				</div>
			<% end %>
		</div>
	</div>
	<%= link_to 'PDF出力履歴を見る', downloads_path, class: 'btn btn-outline-secondary' %>
</div>
<% if @users.blank? %>
	<p class="m-5">運転日報はありません。</p>
<% else %>
	<section class="export_daily_log_index">
		<div class="bg-image h-100">
			<div class="mask d-flex align-items-center h-100" style="background-color: white">
				<div class="container">
					<div class="row justify-content-center">
						<div class="col-12">
							<div class="card">
								<div class="card-body">
									<div class="table-responsive">
										<table class="table table-hover mb-0">
											<thead>
												<tr>
													<th><%= t('activerecord.attributes.user.user_name') %></th>
													<th><%= '今月の運転日報の数' %></th>
												</tr>
											</thead>
											<tbody>
												<% @users.each do |user| %>
													<tr>
														<td scope="row"><%= user.user_name %></td>
														<td class="ms-5"><%= user.daily_logs.length %></td>
													</tr>
												<% end %>
											</tbody>
										</table>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
<% end %>
