FROM ruby:3.2.2-bookworm

ENV BUNDLE_WITHOUT=development:test \
    BUNDLE_PATH=/usr/local/bundle \
    PUPPETEER_SKIP_DOWNLOAD=true

WORKDIR /app

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends build-essential curl libpq-dev postgresql-client zip \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

COPY Gemfile Gemfile.lock ./
RUN bundle config set deployment true \
    && bundle install

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

RUN mkdir -p tmp/pids storage downloads \
    && RAILS_ENV=production SECRET_KEY_BASE=build-only-secret RAILS_SERVE_STATIC_FILES=1 bundle exec rails assets:precompile

EXPOSE 3000

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
